---
// End-of-chapter pointer into the long-form PDF companion.
interface Props { items: string[] }
const { items } = Astro.props;
---

<aside class="godeeper">
  <span class="t">Go deeper in the PDF companion</span>
  <ul>
    {items.map((i) => <li>{i}</li>)}
  </ul>
</aside>

<style>
  .godeeper { border: 1px dashed var(--rule); border-radius: 8px; padding: 0.7rem 1rem; margin: 2rem 0 0.5rem; background: #fafbfc; }
  .t { font-family: var(--sans); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.05em; color: var(--plum); text-transform: uppercase; }
  ul { margin: 0.4rem 0 0; padding-left: 1.2rem; font-size: 0.88rem; color: var(--gray); }
  li { margin-bottom: 0.15rem; }
</style>
