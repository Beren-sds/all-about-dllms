---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { chapters, prevNext } from '../data/chapters';

interface Props {
  title?: string;
  description?: string;
  slug?: string; // chapter slug for prev/next; omit on the hub
  frontmatter?: { title?: string; description?: string; slug?: string };
}

const fm = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? fm.title ?? 'All You Need to Know About dLLMs';
const description =
  Astro.props.description ?? fm.description ?? 'An interactive tutorial on diffusion language models.';
const slug = Astro.props.slug ?? fm.slug;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = slug ? prevNext(slug) : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · All You Need to Know About dLLMs</title>
  </head>
  <body>
    <header class="site-header">
      <a class="home" href={`${base}/`}>All You Need to Know About dLLMs</a>
      <nav>
        <select
          aria-label="Jump to chapter"
          onchange="if (this.value) window.location.href = this.value;"
        >
          <option value="">Chapters…</option>
          {chapters.map((c) => (
            <option value={`${base}/${c.slug}/`} selected={c.slug === slug}>
              {c.n}. {c.title}
            </option>
          ))}
        </select>
      </nav>
    </header>

    <main class="prose">
      <slot />

      {nav && (
        <nav class="chapter-nav">
          {nav.prev ? (
            <a href={`${base}/${nav.prev.slug}/`}>
              <span class="dir">Previous</span>
              {nav.prev.n}. {nav.prev.title}
            </a>
          ) : (
            <a href={`${base}/`}><span class="dir">Up</span>Hub</a>
          )}
          {nav.next ? (
            <a href={`${base}/${nav.next.slug}/`} style="text-align:right">
              <span class="dir">Next</span>
              {nav.next.n}. {nav.next.title}
            </a>
          ) : (
            <a href={`${base}/`} style="text-align:right"><span class="dir">Done</span>Back to the hub</a>
          )}
        </nav>
      )}

      <p class="asof" style="margin-top:2.5rem">
        As of July 2026. Long-form companion:
        <em>The Past and Present of Text Diffusion Models</em> (PDF), which carries
        the full derivations, exercises, and bibliography.
      </p>
    </main>
  </body>
</html>
